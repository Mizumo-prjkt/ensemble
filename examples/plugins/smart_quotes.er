# ID: author.smart-quotes
# Name: Smart Quotes Formatter
# Version: 1.0
# Description: Converts straight quotation marks into typographic curly quotes.

@on_toolbar_click("Format Smart Quotes")
def format_quotes():
    sel = editor.get_selection()
    target_text = sel
    is_selection = True
    if len(target_text) == 0:
        target_text = editor.get_chapter_text()
        is_selection = False
        if len(target_text) == 0:
            status.warn("No text to format", 1)
            return

    # Replace straight double quotes with curly typographic quotes: “ (8220) and ” (8221)
    in_quote = False
    result = ""
    for ch in target_text:
        if ch == '"':
            if in_quote:
                result += chr(8221)
                in_quote = False
            else:
                result += chr(8220)
                in_quote = True
        else:
            result += ch

    if is_selection:
        editor.replace_selection(result)
        status.notify("Converted selection to typographic curly quotes")
    else:
        editor.set_chapter_text(result)
        status.notify("Converted chapter to typographic curly quotes")
